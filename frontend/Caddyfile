# SITE_ADDRESS is a domain (revalo.example.tn) for automatic HTTPS, or :80 locally.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The API lives under /api, like in development, so the session cookie stays first-party.
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
