# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Database password: letters, digits, - and _ only (it goes into a URL).
POSTGRES_PASSWORD=change-this-to-a-long-random-value

# Your domain for automatic HTTPS (DNS must point to the server), or :80 to test locally.
SITE_ADDRESS=:80
# The address people type, used in QR labels and WhatsApp links.
REVALO_PUBLIC_URL=http://localhost

REVALO_WORKSHOP_NAME=Pilot workshop
REVALO_WORKSHOP_GOVERNORATE=Ben Arous
# WhatsApp number buyers reach from the public marketplace.
REVALO_WORKSHOP_PHONE=
# Monthly plan price shown in the owner report.
REVALO_PLAN_TND=120

# Only for `revalo demo` on an empty database (demo accounts share this password).
# Local development uses revalo-demo-2026; leave it empty in production.
REVALO_DEMO_PASSWORD=
